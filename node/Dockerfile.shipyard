FROM node:20-bookworm-slim AS runtime
WORKDIR /app
COPY package*.json ./
COPY scripts/fix-libsodium-wrappers-sumo.cjs ./scripts/
# node-pty falls back to node-gyp on linux/arm64 when no prebuild is available.
# node-gyp requires Python and a C/C++ toolchain to compile native modules.
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
ENV PYTHON=/usr/bin/python3
# Make dependency install resilient to transient registry/network failures in Docker builds.
RUN set -eux; \
  npm config set fetch-retries 5; \
  npm config set fetch-retry-factor 2; \
  npm config set fetch-retry-mintimeout 20000; \
  npm config set fetch-retry-maxtimeout 120000; \
  npm config set prefer-offline true; \
  attempt=1; \
  until npm ci --no-audit --fund=false; do \
    if [ "$attempt" -ge 3 ]; then \
      echo "npm ci failed after ${attempt} attempts"; \
      exit 1; \
    fi; \
    attempt=$((attempt + 1)); \
    echo "npm ci failed, retrying (attempt ${attempt}/3)"; \
    sleep 10; \
  done
# Next.js dev server in this image needs native SWC bindings (wasm bindings fail with turbo.createProject).
RUN NEXT_VERSION="$(node -p "require('./node_modules/next/package.json').version")" \
  && ARCH="$(dpkg --print-architecture)" \
  && if [ "$ARCH" = "arm64" ]; then npm install --no-save "@next/swc-linux-arm64-gnu@$NEXT_VERSION"; \
  elif [ "$ARCH" = "amd64" ]; then npm install --no-save "@next/swc-linux-x64-gnu@$NEXT_VERSION"; \
  else echo "Skipping explicit SWC native install for unsupported arch: $ARCH"; fi
COPY . .
# Prisma requires DATABASE_URL to be present to resolve env() in schema at generate-time.
RUN DATABASE_URL="postgresql://orchwiz:orchwiz_dev@localhost:5432/orchis?schema=public" npm run db:generate
ENV NODE_ENV=development
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0", "--port", "3000"]
