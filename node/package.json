{
  "name": "orchwiz",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "ORCHWIZ_NEXT_DEV=1 tsx server.ts",
    "dev:ngrok:app": "ngrok http 3000",
    "dev:ngrok:webhooks": "ngrok http 4000",
    "dev:ngrok:urls": "npx tsx scripts/ngrok-urls.ts",
    "shipyard:smoke": "npx tsx scripts/shipyard-api-smoke.ts",
    "shipyard:local:debug": "npx tsx scripts/shipyard-local-debug-loop.ts",
    "shipyard:local:cooldown": "npx tsx scripts/shipyard-local-cooldown.ts",
    "test:bot": "npx tsx scripts/playwright-test-bot.ts",
    "test:bot:smoke": "PW_BOT_MODE=smoke npx tsx scripts/playwright-test-bot.ts",
    "test:bot:full": "PW_BOT_MODE=full npx tsx scripts/playwright-test-bot.ts",
    "test:bot:headed": "PW_BOT_MODE=smoke npx tsx scripts/playwright-test-bot.ts --headed",
    "test:bot:ci": "PW_BOT_MODE=smoke CI=1 npx tsx scripts/playwright-test-bot.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "runtime-edge": "tsx src/runtime-edge/server.ts",
    "lint": "eslint .",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "postinstall": "node scripts/fix-libsodium-wrappers-sumo.cjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "npx tsx prisma/seed.ts",
    "data-core:bootstrap-import": "npx tsx scripts/data-core-bootstrap-import.ts",
    "knowledge:ingest": "npx tsx scripts/knowledge-ingest.ts",
    "knowledge:ingest:dry-run": "npx tsx scripts/knowledge-ingest.ts --dry-run",
    "coin:gif": "npx tsx scripts/coin-toss-gif.ts",
    "downloads:sync": "npx tsx scripts/sync-desktop-downloads.ts",
    "downloads:mirror-local": "npx tsx scripts/mirror-local-desktop-downloads.ts",
    "open-source:generate": "npx tsx scripts/generate-open-source-attributions.ts",
    "ops-tracker:export": "npx tsx scripts/ops-tracker-export.ts",
    "ops-tracker:export:dry-run": "npx tsx scripts/ops-tracker-export.ts --dry-run",
    "ops-tracker:backfill": "npx tsx scripts/ops-tracker-export.ts --backfill-days=90"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "overrides": {
    "hono": ">=4.11.7",
    "lodash": ">=4.17.23",
    "undici": ">=6.23.0"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.4.15",
    "@langfuse/client": "^4.6.0",
    "@meshsdk/core": "^1.9.0-beta.98",
    "@octokit/rest": "^22.0.1",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@trustgraph/client": "^1.3.0",
    "better-auth": "^1.0.0",
    "cbor-x": "^1.6.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.563.0",
    "next": "^16.1.4",
    "node-pty": "^1.1.0",
    "pg": "^8.17.2",
    "prom-client": "^15.1.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "reactflow": "^11.11.4",
    "remark-gfm": "^4.0.1",
    "stripe": "^20.3.1",
    "three": "^0.182.0",
    "ws": "^8.18.3",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.4",
    "playwright": "^1.58.2",
    "postcss": "^8.4.38",
    "prisma": "^7.3.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3"
  }
}
