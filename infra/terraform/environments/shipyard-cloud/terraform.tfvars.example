kube_context = "your-cloud-cluster"
namespace    = "orchwiz-shipyard"
app_name     = "orchwiz"
app_image    = "ghcr.io/your-org/orchwiz:latest"
app_port     = 3000
replicas     = 2

database_url_secret_name = "orchwiz-db-url"
database_url             = ""

# Optional: provision PostgreSQL in-cluster and set DATABASE_URL from it (leave database_url empty).
# enable_in_cluster_postgres = true
# postgres_user              = "orchwiz"
# postgres_password          = "replace-with-secure-password"
# postgres_db                = "orchis"
# postgres_chart_version     = "15.3.5"

better_auth_secret  = "replace-with-32-char-secret"
better_auth_url     = "https://orchwiz.example.com"
next_public_app_url = "https://orchwiz.example.com"

github_client_id     = ""
github_client_secret = ""

service_type   = "ClusterIP"
create_ingress = true
ingress_host   = "orchwiz.example.com"
ingress_annotations = {
  "nginx.ingress.kubernetes.io/proxy-body-size" = "10m"
}

app_env = {
  ENABLE_LOCAL_COMMAND_EXECUTION = "false"
  # LANGFUSE_BASE_URL   = "https://langfuse.example.com"
  # LANGFUSE_PUBLIC_KEY = "replace-with-langfuse-public-key"
  # LANGFUSE_SECRET_KEY = "replace-with-langfuse-secret-key"
}

enable_security_audit_cron   = false
security_audit_cron_schedule = "0 * * * *"
security_audit_cron_token    = "replace-with-unique-security-audit-cron-token"
vault_pvc_enabled            = false
vault_pvc_size               = "1Gi"

enable_openclaw         = true
openclaw_image          = "ghcr.io/openclaw/openclaw:latest"
openclaw_gateway_token  = "replace-with-unique-openclaw-token-seed"
# Optional: provide dedicated per-station gateway tokens. When omitted, tokens
# are automatically derived from openclaw_gateway_token (e.g. "<seed>-xo").
# openclaw_gateway_tokens = {
#   xo  = "replace-with-openclaw-xo-token"
#   ops = "replace-with-openclaw-ops-token"
#   eng = "replace-with-openclaw-eng-token"
#   sec = "replace-with-openclaw-sec-token"
#   med = "replace-with-openclaw-med-token"
#   cou = "replace-with-openclaw-cou-token"
# }

enable_spacebot       = false
spacebot_image        = "ghcr.io/qschlegel/orchwiz-spacebot:latest"
spacebot_api_port     = 19898
spacebot_webhook_port = 18789
spacebot_storage_size = "2Gi"
spacebot_env = {
  WEBHOOK_ENABLED = "true"
}

enable_provider_proxy        = true
provider_proxy_image         = "ghcr.io/qschlegel/orchwiz-provider-proxy:latest"
provider_proxy_port          = 4000
provider_proxy_api_key       = "replace-with-unique-provider-proxy-api-key"
provider_proxy_storage_size  = "1Gi"
provider_proxy_default_model = "gpt-5"

# Kubeview is deployed and exposed by default at /kubeview.
enable_kubeview            = true
kubeview_chart_version     = "2.0.6"
kubeview_single_namespace  = false
kubeview_ingress_enabled   = true
kubeview_ingress_host      = "" # defaults to ingress_host when empty
kubeview_ingress_path      = "/kubeview"
kubeview_ingress_class_name = "nginx"
kubeview_ingress_annotations = {}

# Required when kubeview ingress auth enforcement is enabled.
kubeview_ingress_auth_required = true
kubeview_ingress_auth_annotations = {
  "nginx.ingress.kubernetes.io/auth-url"    = "https://auth.example.com/oauth2/auth"
  "nginx.ingress.kubernetes.io/auth-signin" = "https://auth.example.com/oauth2/start?rd=$scheme://$host$request_uri"
}

# Monitoring stack (Grafana, Prometheus, Loki, ClickHouse, Langfuse). When enabled, OrchWiz app
# uses in-cluster URLs (e.g. grafana.monitoring.svc.cluster.local:3000). Set enable_* = true to provision.
# enable_grafana            = true
# grafana_chart_version     = "7.3.0"
# grafana_ingress_enabled   = false
# grafana_ingress_host      = ""
# enable_prometheus         = true
# prometheus_enable_kube_state_metrics = true
# prometheus_enable_node_exporter = false
# metrics_bearer_token = "" # required when enable_prometheus=true; used for app/runtime-edge/provider-proxy /metrics scrape auth
# prometheus_chart_version  = "31.0.0"
# prometheus_blackbox_exporter_chart_version = "11.8.0"
# prometheus_ingress_enabled = false
# prometheus_ingress_host   = ""
# enable_loki               = false
# loki_chart_version        = "6.6.0"
# loki_persistence_enabled  = true
# loki_storage_size         = "10Gi"
# enable_clickhouse         = false
# clickhouse_chart_version  = "4.5.0"
# clickhouse_persistence_enabled = true
# clickhouse_storage_size   = "10Gi"
# enable_langfuse            = false
# langfuse_chart_version    = "1.5.19"
# langfuse_ingress_enabled  = false
# langfuse_ingress_host     = ""
# langfuse_public_key       = ""   # Create project in Langfuse UI after first deploy, then paste
# langfuse_secret_key       = ""
# langfuse_salt             = ""   # openssl rand -base64 32
# langfuse_nextauth_secret  = ""   # openssl rand -hex 32
# langfuse_encryption_key   = ""   # openssl rand -hex 32
# langfuse_postgres_password = ""
# langfuse_redis_password   = ""
# langfuse_clickhouse_password = ""
# langfuse_minio_root_password = ""
# monitoring_storage_class  = ""  # empty = cluster default StorageClass

# Optional: install arbitrary Helm charts into this ship.
# NOTE: Prefer subdomains (not path prefixes) for Next.js-based UIs to avoid /_next collisions.
#
# extra_helm_releases = {
#   serviceradar = {
#     repository      = "oci://ghcr.io/carverauto/charts"
#     chart           = "serviceradar"
#     version         = "1.0.75"
#     timeout_seconds = 1200
#     set = {
#       # Pin images to the matching app version tag.
#       "global.imageTag" = "v1.0.75"
#
#       # Disable chart-provided ingress (it adds external-dns annotations).
#       "ingress.enabled" = "false"
#
#       # Avoid requiring an imagePullSecret by default (set this to your secret name if needed).
#       "image.registryPullSecret" = ""
#     }
#   }
# }
#
# # Optional: expose add-ons via ingress (host auto-defaults to NAME.<ingress_host>).
# extra_ingresses = {
#   serviceradar = {
#     path         = "/"
#     service_name = "serviceradar-web"
#     service_port = 3000
#     annotations  = {}
#   }
# }
