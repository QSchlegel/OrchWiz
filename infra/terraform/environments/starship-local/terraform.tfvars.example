infrastructure_kind = "kind"
kube_context = "kind-orchwiz" # set to "minikube" when infrastructure_kind = "minikube"
namespace    = "orchwiz-starship"
app_name     = "orchwiz"
app_image    = "orchwiz:local-dev"

openclaw_image         = "ghcr.io/openclaw/openclaw:latest"
openclaw_gateway_token = "orchwiz-openclaw-dev-token"
# Optional: provide dedicated per-station gateway tokens. When omitted, tokens
# are automatically derived from openclaw_gateway_token (e.g. "<seed>-xo").
# openclaw_gateway_tokens = {
#   xo  = "orchwiz-openclaw-dev-token-xo"
#   ops = "orchwiz-openclaw-dev-token-ops"
#   eng = "orchwiz-openclaw-dev-token-eng"
#   sec = "orchwiz-openclaw-dev-token-sec"
#   med = "orchwiz-openclaw-dev-token-med"
#   cou = "orchwiz-openclaw-dev-token-cou"
# }

provider_proxy_image         = "ghcr.io/qschlegel/orchwiz-provider-proxy:latest"
provider_proxy_port          = 4000
provider_proxy_api_key       = "orchwiz-provider-proxy-dev-key"
provider_proxy_storage_size  = "1Gi"
provider_proxy_default_model = "gpt-5"

postgres_user     = "orchwiz"
postgres_password = "orchwiz_dev"
postgres_db       = "orchis"

better_auth_secret  = "replace-with-32-char-secret"
better_auth_url     = "http://localhost:3000"
next_public_app_url = "http://localhost:3000"

github_client_id     = ""
github_client_secret = ""

app_env = {
  ENABLE_LOCAL_COMMAND_EXECUTION = "false"
  # LANGFUSE_BASE_URL   = "https://langfuse.example.com"
  # LANGFUSE_PUBLIC_KEY = "replace-with-langfuse-public-key"
  # LANGFUSE_SECRET_KEY = "replace-with-langfuse-secret-key"
}

enable_security_audit_cron   = false
security_audit_cron_schedule = "0 * * * *"
security_audit_cron_token    = "orchwiz-security-audit-dev-token"
vault_pvc_enabled            = false
vault_pvc_size               = "1Gi"

# Kubeview is deployed by default in local profile.
# Ingress exposure is opt-in; keep disabled unless local ingress is configured.
enable_kubeview          = true
kubeview_chart_version   = "2.0.6"
kubeview_single_namespace = false
kubeview_ingress_enabled = false
kubeview_ingress_host    = ""
kubeview_ingress_path    = "/kubeview"
kubeview_ingress_class_name = "nginx"
kubeview_ingress_annotations = {}

# Monitoring stack (Grafana, Prometheus, Loki, ClickHouse, Langfuse). Set enable_* = true to provision.
# When enabled, OrchWiz app uses in-cluster URLs. For local dev with app on host, port-forward monitoring services or set GRAFANA_UPSTREAM_URL / PROMETHEUS_UPSTREAM_URL.
# enable_grafana   = false
# enable_prometheus = false
# enable_loki      = false
# enable_clickhouse = false
# enable_langfuse  = false
# monitoring_storage_class = ""

# Optional: install arbitrary Helm charts into this ship.
# NOTE: Prefer subdomains (not path prefixes) for Next.js-based UIs to avoid /_next collisions.
#
# extra_helm_releases = {
#   serviceradar = {
#     repository      = "oci://ghcr.io/carverauto/charts"
#     chart           = "serviceradar"
#     version         = "1.0.75"
#     timeout_seconds = 1200
#     set = {
#       # Pin images to the matching app version tag.
#       "global.imageTag" = "v1.0.75"
#
#       # Disable chart-provided ingress (it adds external-dns annotations).
#       "ingress.enabled" = "false"
#
#       # Avoid requiring an imagePullSecret by default (set this to your secret name if needed).
#       "image.registryPullSecret" = ""
#     }
#   }
# }
#
# # Optional: expose add-ons via ingress (host auto-defaults to NAME.<namespace>.localhost).
# extra_ingresses = {
#   serviceradar = {
#     path         = "/"
#     service_name = "serviceradar-web"
#     service_port = 3000
#     annotations  = {}
#   }
# }
