{
  "id": null,
  "uid": "ship-oncall-cc",
  "title": "Ship On-Call Command Center",
  "tags": ["orchwiz", "ship", "oncall", "situational-awareness"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Service Probes Down",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((probe_success{job=\"ship-service-probes\"} == 0) * 1) or vector(0)",
          "legendFormat": "down"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Metrics Scrapes Down",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((up{job=\"ship-service-metrics\"} == 0) * 1) or vector(0)",
          "legendFormat": "down"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Firing Alerts",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "alerts"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Pods Not Ready",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((kube_pod_status_ready{condition=\"true\"} == 0) * 1) or vector(0)",
          "legendFormat": "pods"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "5xx Error Rate by Service (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum by (service) (rate(orchwiz_http_requests_total{status_class=\"5xx\"}[5m])) / clamp_min(sum by (service) (rate(orchwiz_http_requests_total[5m])), 0.001))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "p95 Latency by Service (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(orchwiz_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Metrics Endpoint Health",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"ship-service-metrics\"}",
          "format": "table",
          "legendFormat": "{{service}} {{instance}}"
        }
      ],
      "options": {
        "showHeader": true,
        "footer": { "show": false }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Pod Readiness (kube-state-metrics)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (namespace, pod) (kube_pod_status_ready{condition=\"true\"})",
          "format": "table",
          "legendFormat": "{{namespace}}/{{pod}}"
        },
        {
          "refId": "B",
          "expr": "sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total[15m]))",
          "format": "table",
          "legendFormat": "{{namespace}}/{{pod}} restarts"
        }
      ],
      "options": {
        "showHeader": true,
        "footer": { "show": false }
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "OpenClaw Station Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "OpenClaw Probe Success",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"ship-service-probes\", service=~\"openclaw-.*\"}",
          "legendFormat": "{{service}}"
        }
      ]
    }
  ]
}
