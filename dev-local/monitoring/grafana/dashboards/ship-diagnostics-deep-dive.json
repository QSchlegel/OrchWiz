{
  "id": null,
  "uid": "ship-diagnostics-dd",
  "title": "Ship Diagnostics Deep Dive",
  "tags": ["orchwiz", "ship", "diagnostics", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "time": {
    "from": "now-2h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "query": {
          "query": "label_values(orchwiz_http_requests_total, service)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request Volume by Service (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(orchwiz_http_requests_total[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Status Class Breakdown (Selected Services)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, status_class) (rate(orchwiz_http_requests_total{service=~\"$service\"}[5m]))",
          "legendFormat": "{{service}} {{status_class}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p50 / p95 (s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, service) (rate(orchwiz_http_request_duration_seconds_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "{{service}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(orchwiz_http_request_duration_seconds_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "{{service}} p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "In-Flight Requests",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "orchwiz_http_in_flight_requests{service=~\"$service\"}",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Runtime CPU (%)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "orchwiz_runtime_cpu_percent{service=~\"$service\"}",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Runtime Heap Pressure (%)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "orchwiz_runtime_heap_pressure_percent{service=~\"$service\"}",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Runtime Event Loop Lag p95 (ms)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "orchwiz_runtime_event_loop_lag_p95_ms{service=~\"$service\"}",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Probe Latency p95 by Service (s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(probe_duration_seconds_bucket{job=\"ship-service-probes\",service=~\"$service\"}[5m])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Probe Failures Timeline",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) ((probe_success{job=\"ship-service-probes\",service=~\"$service\"} == 0) * 1)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Prometheus Scrape Samples / sec",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(scrape_samples_scraped[5m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Prometheus Query p95 + Rule Eval p95 (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(prometheus_engine_query_duration_seconds_bucket[5m])))",
          "legendFormat": "query p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(prometheus_rule_group_duration_seconds_bucket[5m])))",
          "legendFormat": "rule eval p95"
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Probe Target Health Matrix",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"ship-service-probes\",service=~\"$service\"}",
          "format": "table",
          "legendFormat": "{{service}} {{instance}}"
        }
      ],
      "options": {
        "showHeader": true,
        "footer": { "show": false }
      }
    }
  ]
}
